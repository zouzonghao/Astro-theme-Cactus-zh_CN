---
import { getEntry, render } from "astro:content";
import PageLayout from "@/layouts/Base.astro";

// 内容来自 content/pages/about.md（后台「页面 → 关于页」编辑）
const about = await getEntry("page", "about");
if (!about) {
	throw new Error("缺少 content/pages/about.md，请在后台「页面 → 关于页」中创建");
}
const { Content } = await render(about);
---

<PageLayout meta={{ title: about.data.title, description: about.data.description }}>
	<h1 class="title mb-12">{about.data.title}</h1>
	<div class="prose prose-sm prose-cactus max-w-none">
		<Content />
	</div>
</PageLayout>
