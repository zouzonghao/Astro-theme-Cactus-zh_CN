---
import { readFileSync } from "node:fs";
import { siteConfig } from "@/site.config";

/**
 * 站点常量在构建时从 /admin/config.yml 与站点设置读取，
 * 更换仓库/分支/域名只需修改 config.yml，无需改动本文件。
 * 与 site.config.ts 同理：cwd 为项目根目录，不能用 import.meta.url 相对路径。
 */
function readAdminConfig(key: string): string {
	try {
		const yml = readFileSync(`${process.cwd()}/public/admin/config.yml`, "utf8");
		return yml.match(new RegExp(`^\\s*${key}:\\s*([^#\\s]+)`, "m"))?.[1] ?? "";
	} catch {
		return "";
	}
}

const REPO = readAdminConfig("repo");
const BRANCH = readAdminConfig("branch");
const REPO_DIR = readAdminConfig("media_folder"); // 仓库内目录
const PUBLIC_DIR = readAdminConfig("public_folder"); // 访问路径前缀
const SITE_URL = siteConfig.url.replace(/\/+$/, ""); // 完整链接域名（与 site.json 一致，固定用生产地址）
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="noindex" />
		<link rel="icon" href="/icon.svg" type="image/svg+xml" />
		<title>图片上传 · 浏览器内压缩</title>
		<style is:inline>
			/* 主题变量取自 Sveltia UI 的 variables.scss（基础色相 210） */
			:root {
				color-scheme: light dark;
				--bg: hsl(210 5% 98%); /* 页面背景 */
				--surface: hsl(210 5% 100%); /* 卡片表面 */
				--fg: hsl(210 5% 5%); /* 主文字 */
				--fg2: hsl(210 5% 25%); /* 次文字 */
				--muted: hsl(210 5% 45%);
				--border: hsl(210 5% 60% / 45%);
				--accent: hsl(210 80% 40%);
				--accent-soft: hsl(210 80% 40% / 10%);
				--ok: hsl(150 60% 32%);
				--ok-soft: hsl(150 60% 32% / 12%);
				--err: hsl(0 60% 42%);
				--err-soft: hsl(0 60% 42% / 12%);
				--warn-soft: hsl(40 80% 40% / 15%);
				--shadow: 0 1px 2px hsl(210 10% 0% / 6%), 0 2px 8px hsl(210 10% 0% / 4%);
				--radius: 4px; /* Sveltia 控件圆角 = 高度 32px / 8 */
				--control-h: 32px; /* Sveltia medium 控件高度 */
			}
			@media (prefers-color-scheme: dark) {
				:root {
					--bg: hsl(210 10% 10%);
					--surface: hsl(210 10% 8%);
					--fg: hsl(210 10% 95%);
					--fg2: hsl(210 10% 75%);
					--muted: hsl(210 10% 55%);
					--border: hsl(210 10% 40% / 50%);
					--accent: hsl(210 100% 40%);
					--accent-soft: hsl(210 100% 40% / 14%);
					--ok: hsl(150 60% 50%);
					--ok-soft: hsl(150 60% 50% / 14%);
					--err: hsl(0 70% 58%);
					--err-soft: hsl(0 70% 58% / 14%);
					--shadow: 0 1px 2px hsl(210 10% 0% / 30%), 0 2px 8px hsl(210 10% 0% / 20%);
				}
			}
			* {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				font-family: "Source Sans 3", system-ui, -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
				font-size: 15px;
				line-height: 1.5;
				background: var(--bg);
				color: var(--fg);
			}
			button {
				font: inherit;
				height: var(--control-h);
				padding: 0 14px;
				border-radius: var(--radius);
				border: 1px solid var(--border);
				background: var(--surface);
				color: var(--fg);
				cursor: pointer;
				display: inline-flex;
				align-items: center;
				gap: 6px;
				transition: background 0.15s, border-color 0.15s, box-shadow 0.15s;
			}
			button:hover {
				background: var(--accent-soft);
			}
			button:focus-visible,
			select:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: 1px;
			}
			button.primary {
				background: var(--accent);
				border-color: var(--accent);
				color: #fff;
				font-weight: 600;
			}
			button.primary:hover {
				filter: brightness(1.08);
				background: var(--accent);
			}
			button:disabled {
				opacity: 0.45;
				cursor: not-allowed;
			}
			a {
				color: var(--accent);
			}

			/* 顶部工具栏（对应 Sveltia GlobalToolbar） */
			.topbar {
				position: sticky;
				top: 0;
				z-index: 10;
				background: var(--surface);
				border-bottom: 1px solid var(--border);
				box-shadow: var(--shadow);
			}
			.topbar-inner {
				max-width: 800px;
				margin: 0 auto;
				padding: 10px 16px;
				display: flex;
				align-items: center;
				gap: 12px;
				flex-wrap: wrap;
			}
			.brand {
				display: flex;
				align-items: center;
				gap: 10px;
				min-width: 0;
			}
			.brand svg {
				color: var(--accent);
				flex-shrink: 0;
			}
			h1 {
				font-size: 16px;
				margin: 0;
				font-weight: 700;
				white-space: nowrap;
			}
			h1 .sub {
				font-size: 12px;
				font-weight: 400;
				color: var(--muted);
				margin-left: 8px;
			}
			.authbar {
				margin-left: auto;
				display: flex;
				align-items: center;
				gap: 8px;
				font-size: 13px;
				color: var(--fg2);
				min-width: 0;
			}
			.authbar .dot {
				width: 8px;
				height: 8px;
				border-radius: 50%;
				background: var(--muted);
				flex-shrink: 0;
			}
			.authbar.ok .dot {
				background: var(--ok);
			}
			.authbar.err .dot {
				background: var(--err);
			}
			.authbar #authtext {
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}

			.wrap {
				max-width: 800px;
				margin: 0 auto;
				padding: 20px 16px 64px;
			}
			.card {
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: 8px;
				box-shadow: var(--shadow);
				padding: 14px 16px;
				margin-bottom: 16px;
			}

			/* 压缩选项 */
			.opts {
				display: flex;
				gap: 20px;
				flex-wrap: wrap;
				align-items: flex-end;
			}
			.opts label {
				display: flex;
				flex-direction: column;
				gap: 4px;
				font-size: 13px;
				color: var(--fg2);
			}
			select {
				font: inherit;
				height: var(--control-h);
				color: var(--fg);
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				padding: 0 8px;
				min-width: 120px;
			}

			/* 拖拽区 */
			.dropzone {
				border: 2px dashed var(--border);
				border-radius: 8px;
				padding: 44px 16px;
				text-align: center;
				color: var(--muted);
				margin-bottom: 16px;
				transition: border-color 0.15s, background 0.15s;
			}
			.dropzone.drag {
				border-color: var(--accent);
				background: var(--accent-soft);
				color: var(--accent);
			}
			.dropzone .big {
				font-size: 15px;
				margin-bottom: 10px;
				color: var(--fg2);
			}

			/* 工具栏与列表 */
			.toolbar {
				display: flex;
				gap: 10px;
				flex-wrap: wrap;
				margin-bottom: 14px;
			}
			.filelist {
				display: flex;
				flex-direction: column;
				gap: 10px;
			}
			.item {
				display: grid;
				grid-template-columns: 84px 1fr;
				gap: 14px;
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: 8px;
				box-shadow: var(--shadow);
				padding: 12px;
			}
			.item img {
				width: 84px;
				height: 84px;
				object-fit: cover;
				border-radius: var(--radius);
				background: repeating-conic-gradient(hsl(210 5% 60% / 30%) 0 25%, hsl(210 5% 60% / 15%) 0 50%) 0 0 / 16px 16px;
			}
			.item .info {
				min-width: 0;
			}
			.item .name {
				font-size: 14px;
				font-weight: 600;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}
			.item .meta {
				font-size: 13px;
				color: var(--muted);
				margin-top: 2px;
			}
			.item .meta strong {
				color: var(--fg);
			}
			.item .meta .save {
				color: var(--ok);
				font-weight: 700;
			}
			.badge {
				display: inline-flex;
				align-items: center;
				gap: 6px;
				margin-top: 6px;
				padding: 2px 10px;
				border-radius: 99px;
				font-size: 12px;
				background: var(--accent-soft);
				color: var(--fg2);
			}
			.statusrow {
				display: flex;
				align-items: center;
				gap: 8px;
				margin-top: 6px;
				min-width: 0;
			}
			.statusrow .badge {
				margin-top: 0;
				min-width: 0;
				max-width: 100%;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}
			.retry-btn {
				height: 24px;
				padding: 0 10px;
				font-size: 12px;
				flex-shrink: 0;
			}
			.badge.ok {
				background: var(--ok-soft);
				color: var(--ok);
			}
			.badge.err {
				background: var(--err-soft);
				color: var(--err);
			}
			.badge.busy::before {
				content: "";
				width: 10px;
				height: 10px;
				border-radius: 50%;
				border: 2px solid currentColor;
				border-top-color: transparent;
				animation: spin 0.8s linear infinite;
			}
			@keyframes spin {
				to {
					transform: rotate(360deg);
				}
			}
			.links {
				margin-top: 8px;
				display: flex;
				flex-direction: column;
				gap: 5px;
			}
			.linkrow {
				display: flex;
				gap: 6px;
				align-items: center;
				font-size: 12px;
				min-width: 0;
			}
			.linkrow code {
				flex: 1;
				min-width: 0;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
				font-family: "Noto Sans Mono", ui-monospace, monospace;
				background: var(--bg);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				padding: 4px 8px;
			}
			.linkrow button {
				height: 26px;
				padding: 0 10px;
				font-size: 12px;
				flex-shrink: 0;
			}
			.hint {
				font-size: 13px;
				color: var(--muted);
				margin-top: 16px;
			}
			@media (max-width: 560px) {
				.item {
					grid-template-columns: 64px 1fr;
				}
				.item img {
					width: 64px;
					height: 64px;
				}
			}

			/* 左下角悬浮按钮：返回 CMS 后台 */
			.back-fab {
				position: fixed;
				left: 20px;
				bottom: 20px;
				z-index: 9999;
				display: inline-flex;
				align-items: center;
				gap: 8px;
				height: 40px;
				padding: 0 16px;
				border-radius: 20px;
				background: var(--accent);
				color: #fff;
				text-decoration: none;
				font-size: 14px;
				font-weight: 600;
				box-shadow: 0 2px 8px hsl(210 10% 0% / 25%);
				transition: filter 0.15s, transform 0.15s;
			}
			.back-fab:hover {
				filter: brightness(1.1);
				transform: translateY(-1px);
			}
			.back-fab:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: 2px;
			}
		</style>
	</head>
	<body>
		<header class="topbar">
			<div class="topbar-inner">
				<div class="brand">
					<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
						<path d="M11 15h2V8.8l2.6 2.6 1.4-1.4L12 5 7 10l1.4 1.4L11 8.8V15zM5 18h14v2H5v-2z" />
					</svg>
					<h1>图片上传<span class="sub">浏览器内压缩 · AVIF / WebP / MozJPEG</span></h1>
				</div>
				<div class="authbar" id="authbar">
					<span class="dot"></span><span id="authtext">正在检查登录状态…</span>
					<button id="loginbtn" style="display: none">使用 GitHub 授权登录</button>
				</div>
			</div>
		</header>

		<main class="wrap">
			<section class="card">
				<div class="opts">
					<label>
						输出格式
						<select id="opt-format">
							<option value="avif" selected>AVIF（推荐）</option>
							<option value="webP">WebP</option>
							<option value="mozJPEG">MozJPEG</option>
						</select>
					</label>
					<label>
						质量
						<select id="opt-quality">
							<option value="high">高质量</option>
							<option value="mid" selected>均衡</option>
							<option value="low">高压缩</option>
						</select>
					</label>
					<label>
						最长边
						<select id="opt-side">
							<option value="0">原图</option>
							<option value="1280">1280px</option>
							<option value="1600">1600px</option>
							<option value="2048" selected>2048px</option>
						</select>
					</label>
				</div>
			</section>

			<section class="dropzone" id="dropzone">
					<div class="big">拖拽图片到页面任意位置、Ctrl+V 粘贴截图，或点击选择</div>
				<button id="pickbtn">选择图片</button>
				<div style="margin-top: 8px; font-size: 13px">支持多选；GIF / SVG 将原样上传，不压缩</div>
				<input type="file" id="fileinput" accept="image/*" multiple hidden />
			</section>

			<div class="toolbar" id="toolbar" style="display: none">
				<button class="primary" id="uploadallbtn">全部上传到 GitHub</button>
				<button id="recompressbtn">按当前设置重新压缩</button>
				<button id="clearbtn">清空列表</button>
			</div>

			<div class="filelist" id="filelist"></div>

			<p class="hint">
				上传会直接 commit 到 GitHub 仓库 <code>public/assets/images/</code> 并触发 Vercel 重新构建（约
				1–2 分钟后可访问）；<strong>多张图片会自动合并为一次提交，只触发一次构建</strong>，<strong>与仓库现有内容完全相同的图片会自动去重、直接复用</strong>。写文章时在
				<a href="/admin/" target="_blank" rel="noopener">Sveltia CMS</a> 里粘贴返回的
				Markdown 链接即可；压缩引擎与 <a href="https://github.com/XPoet/picx" target="_blank" rel="noopener">PicX</a>
				相同（Squoosh WASM，全程在浏览器内完成，原图不会离开本机）。
			</p>
		</main>

		<a class="back-fab" href="/admin/" title="返回内容管理后台">
			<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
				<path d="M20 11H7.8l5.6-5.6L12 4l-8 8 8 8 1.4-1.4L7.8 13H20v-2z" />
			</svg>
			返回后台
		</a>

		<script is:inline type="module" define:vars={{ REPO, BRANCH, REPO_DIR, PUBLIC_DIR, SITE_URL }}>
			// ===== 站点常量由构建时从 /admin/config.yml 与站点设置注入（见文件顶部 frontmatter）=====

			// ===== 压缩引擎（esm.sh 加载 Squoosh WASM，与 PicX 同款）=====
			const SQUOOSH = "https://esm.sh/@yireen/squoosh-browser@1.0.7";
			let squoosh = null;
			async function loadSquoosh() {
				if (!squoosh) {
					const [main, meta] = await Promise.all([
						import(SQUOOSH),
						import(`${SQUOOSH}/dist/client/lazy-app/feature-meta`),
					]);
					squoosh = { Compress: main.default, meta };
				}
				return squoosh;
			}

			// 质量档位 → 各编码器参数（avif 的 cqLevel 为 0-63，越小质量越高）
			const QUALITY = {
				high: { avif: { cqLevel: 24 }, webP: { quality: 88 }, mozJPEG: { quality: 88 } },
				mid: { avif: { cqLevel: 33 }, webP: { quality: 78 }, mozJPEG: { quality: 80 } },
				low: { avif: { cqLevel: 42 }, webP: { quality: 65 }, mozJPEG: { quality: 68 } },
			};

			// 需要压缩的 MIME（沿用 PicX 的判断；gif/svg 等直接透传）
			const COMPRESS_TYPES = /(png|jpg|jpeg|webp|avif)$/i;

			// ===== GitHub 认证：优先复用 Sveltia CMS 的登录态 =====
			const OWN_TOKEN_KEY = "img-uploader.token";

			function readSveltiaUser() {
				try {
					const u = JSON.parse(localStorage.getItem("sveltia-cms.user") || "null");
					if (u && u.backendName === "github" && typeof u.token === "string" && u.token) {
						return { token: u.token, login: u.login || "", source: "Sveltia CMS 登录态" };
					}
				} catch {
					/* 忽略损坏的缓存 */
				}
				return null;
			}

			function readOwnToken() {
				const token = localStorage.getItem(OWN_TOKEN_KEY);
				return token ? { token, login: "", source: "本页授权缓存" } : null;
			}

			let auth = null; // { token, login, source }

			async function ghFetch(path, options = {}) {
				return fetch(`https://api.github.com${path}`, {
					...options,
					headers: {
						Accept: "application/vnd.github+json",
						"X-GitHub-Api-Version": "2022-11-28",
						Authorization: `Bearer ${auth.token}`,
						...(options.headers || {}),
					},
				});
			}

			async function validateAuth() {
				const candidates = [readSveltiaUser(), readOwnToken()].filter(Boolean);
				for (const c of candidates) {
					auth = c;
					try {
						const res = await ghFetch("/user");
						if (res.ok) {
							const u = await res.json();
							auth = { ...c, login: u.login || c.login };
							return true;
						}
					} catch {
						/* 网络问题则尝试下一个候选 */
					}
				}
				auth = null;
				return false;
			}

			function renderAuthbar() {
				const bar = document.getElementById("authbar");
				const text = document.getElementById("authtext");
				const btn = document.getElementById("loginbtn");
				if (auth) {
					bar.className = "authbar ok";
					text.textContent = `已登录：${auth.login}（复用 ${auth.source}）`;
					btn.style.display = "none";
				} else {
					bar.className = "authbar err";
					text.textContent = "未登录——可先在 /admin/ 登录 Sveltia CMS，或直接在此授权";
					btn.style.display = "";
				}
			}

			// 与 /oauth/callback 的 Decap/Sveltia postMessage 协议握手
			function loginWithGithub() {
				const popup = window.open("/oauth", "cms-oauth", "width=640,height=720");
				if (!popup) {
					alert("弹窗被浏览器拦截，请允许弹窗后重试");
					return;
				}
				const handler = (event) => {
					if (event.data === "authorizing:github") {
						// 回复任意消息，触发回调页回传 token
						event.source?.postMessage("authorizing:ack", event.origin);
						return;
					}
					if (typeof event.data === "string" && event.data.startsWith("authorization:github:success:")) {
						const { token } = JSON.parse(event.data.slice("authorization:github:success:".length));
						localStorage.setItem(OWN_TOKEN_KEY, token);
						window.removeEventListener("message", handler);
						popup.close();
						validateAuth().then(renderAuthbar);
					}
				};
				window.addEventListener("message", handler);
			}

			// ===== 文件队列 =====
			/** @type {Array<{id:number, raw:File, out:File|null, status:string, error:string, uploadedName:string}>} */
			let queue = [];
			let uid = 0;

			const STATUS_TEXT = {
				pending: "待压缩",
				compressing: "压缩中…",
				compressed: "已压缩，待上传",
				uploading: "上传中…",
				done: "已上传",
				error: "",
			};
			const STATUS_CLASS = {
				compressing: "busy",
				uploading: "busy",
				done: "ok",
				error: "err",
			};

			function fmtSize(bytes) {
				if (bytes < 1024) return `${bytes} B`;
				if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
				return `${(bytes / 1024 / 1024).toFixed(2)} MB`;
			}

			async function targetDims(raw, maxSide) {
				if (!maxSide) return null;
				const bmp = await createImageBitmap(raw);
				const { width, height } = bmp;
				bmp.close();
				const scale = Math.min(maxSide / Math.max(width, height), 1);
				if (scale >= 1) return null;
				return { width: Math.max(1, Math.round(width * scale)), height: Math.max(1, Math.round(height * scale)) };
			}

			async function compressOne(item) {
				const format = document.getElementById("opt-format").value;
				const quality = document.getElementById("opt-quality").value;
				const maxSide = Number(document.getElementById("opt-side").value);

				if (!COMPRESS_TYPES.test(rawType(item.raw))) {
					item.out = item.raw; // gif/svg 等透传
					item.status = "compressed";
					return;
				}

				const { Compress, meta } = await loadSquoosh();
				const encoder = format === "avif" ? "avif" : format === "webP" ? "webP" : "mozJPEG";
				const dims = await targetDims(item.raw, maxSide);
				const compress = new Compress(item.raw, {
					encoderState: {
						type: encoder,
						options: { ...meta.encoderMap[encoder].meta.defaultOptions, ...QUALITY[quality][encoder] },
					},
					processorState: {
						quantize: { ...meta.defaultProcessorState.quantize },
						resize: {
							...meta.defaultProcessorState.resize,
							...(dims ? { enabled: true, ...dims } : {}),
						},
					},
					preprocessorState: { ...meta.defaultPreprocessorState },
				});
				item.out = await compress.process(); // 输出 File，扩展名已替换
				item.status = "compressed";
			}

			function rawType(file) {
				return file.type || (file.name.split(".").pop() || "");
			}

			async function compressQueue() {
				for (const item of queue) {
					// uploading/done 不可动；compressed 已完成无需重压（重新压缩按钮会先重置为 pending）
					if (["uploading", "done", "compressed"].includes(item.status)) continue;
					item.status = "compressing";
					item.error = "";
					render();
					try {
						await compressOne(item);
					} catch (ex) {
						item.status = "error";
						item.error = `压缩失败：${ex?.message || ex}`;
					}
					render();
				}
			}

			// ===== 上传 =====
			function bufToB64(buf) {
				const bytes = new Uint8Array(buf);
				let bin = "";
				const CHUNK = 0x8000;
				for (let i = 0; i < bytes.length; i += CHUNK) {
					bin += String.fromCharCode(...bytes.subarray(i, i + CHUNK));
				}
				return btoa(bin);
			}

			function genName(outFile, seq) {
				const ext = (outFile.name.split(".").pop() || "bin").toLowerCase();
				const d = new Date();
				const p = (n) => String(n).padStart(2, "0");
				const base = `${d.getFullYear()}${p(d.getMonth() + 1)}${p(d.getDate())}-${p(d.getHours())}${p(d.getMinutes())}${p(d.getSeconds())}`;
				return `${base}${seq > 1 ? `-${seq}` : ""}.${ext}`;
			}

			// 抛错前尽力读出 GitHub 返回的错误信息
			async function throwGHError(res, action) {
				let msg = `HTTP ${res.status}`;
				try {
					const body = await res.json();
					msg = body.message || msg;
				} catch {
					/* 保留状态码信息 */
				}
				throw new Error(`${action}失败：${msg}`);
			}

			// ===== 去重：按内容哈希（git blob SHA-1）检测仓库中已存在的相同文件 =====
			// Git blob 哈希 = sha1("blob <字节数>\0" + 内容)，与 GitHub 目录条目的 sha 字段同源，
			// 本地计算后可直接与远端比对，无需下载文件内容
			let repoListing = null; // [{ name, sha, type }] 目录缓存，上传成功后增量更新

			async function fetchListing() {
				if (!repoListing) {
					try {
						const res = await ghFetch(`/repos/${REPO}/contents/${REPO_DIR}?ref=${BRANCH}`);
						repoListing = res.ok ? await res.json() : [];
					} catch {
						repoListing = []; // 拿不到列表就跳过去重，直接上传
					}
				}
				return repoListing;
			}

			async function gitBlobSha(bytes) {
				const head = new TextEncoder().encode(`blob ${bytes.length}\0`);
				const merged = new Uint8Array(head.length + bytes.length);
				merged.set(head, 0);
				merged.set(bytes, head.length);
				const digest = await crypto.subtle.digest("SHA-1", merged);
				return [...new Uint8Array(digest)].map((b) => b.toString(16).padStart(2, "0")).join("");
			}

			// 内容与仓库现有文件完全一致时返回 { name, sha }，否则返回 null
			async function findDuplicate(item) {
				const bytes = new Uint8Array(await item.out.arrayBuffer());
				const sha = await gitBlobSha(bytes);
				const hit = (await fetchListing()).find((f) => f.type === "file" && f.sha === sha);
				item.blobSha = sha; // 供上传成功后更新目录缓存
				return hit ? { name: hit.name, sha } : null;
			}

			// 单图：Contents API，一次 PUT 即一次 commit
			async function uploadSingle(item, seq) {
				let name = genName(item.out, seq);
				const content = bufToB64(await item.out.arrayBuffer());
				const put = (filename) =>
					ghFetch(`/repos/${REPO}/contents/${REPO_DIR}/${filename}`, {
						method: "PUT",
						body: JSON.stringify({
							message: `上传图片 ${filename}（浏览器压缩）`,
							branch: BRANCH,
							content,
						}),
					});

				let res = await put(name);
				if (res.status === 422 || res.status === 409) {
					// 文件名撞车：换随机后缀重试一次
					name = name.replace(/\.(\w+)$/, `-${Math.random().toString(36).slice(2, 6)}.$1`);
					res = await put(name);
				}
				if (!res.ok) await throwGHError(res, "上传");
				item.uploadedName = name;
			}

			// 多图：Git Data API 打包为一次 commit（blobs → tree → commit → 移动分支指针），
			// 与 PicX 批量上传同款流程，多张图只触发一次 Vercel 构建
			async function uploadBatch(items) {
				// 1. 逐张创建 blob（只存内容，尚未进树，失败无副作用）
				const blobs = [];
				for (const item of items) {
					const content = bufToB64(await item.out.arrayBuffer());
					const res = await ghFetch(`/repos/${REPO}/git/blobs`, {
						method: "POST",
						body: JSON.stringify({ content, encoding: "base64" }),
					});
					if (!res.ok) await throwGHError(res, "创建 blob");
					blobs.push({ item, sha: (await res.json()).sha });
				}

				// 2-5. 组装 tree 与 commit 并移动分支指针；指针被并发移动（422）时整体重试一次
				for (let attempt = 0; ; attempt++) {
					const branchRes = await ghFetch(`/repos/${REPO}/branches/${BRANCH}`);
					if (!branchRes.ok) await throwGHError(branchRes, "获取分支");
					const branch = await branchRes.json();

					let seq = 1;
					const tree = blobs.map(({ item, sha }) => {
						item.uploadedName = genName(item.out, seq++);
						return { path: `${REPO_DIR}/${item.uploadedName}`, mode: "100644", type: "blob", sha };
					});

					const treeRes = await ghFetch(`/repos/${REPO}/git/trees`, {
						method: "POST",
						body: JSON.stringify({ base_tree: branch.commit.commit.tree.sha, tree }),
					});
					if (!treeRes.ok) await throwGHError(treeRes, "创建 tree");
					const newTree = await treeRes.json();

					const commitRes = await ghFetch(`/repos/${REPO}/git/commits`, {
						method: "POST",
						body: JSON.stringify({
							message: `上传图片 ${tree.length} 张（浏览器压缩）`,
							tree: newTree.sha,
							parents: [branch.commit.sha],
						}),
					});
					if (!commitRes.ok) await throwGHError(commitRes, "创建 commit");
					const newCommit = await commitRes.json();

					const refRes = await ghFetch(`/repos/${REPO}/git/refs/heads/${BRANCH}`, {
						method: "PATCH",
						body: JSON.stringify({ sha: newCommit.sha }),
					});
					if (refRes.ok) return;
					if (refRes.status === 422 && attempt === 0) continue;
					await throwGHError(refRes, "更新分支");
				}
			}

			// 单张重试：压缩阶段失败（无 out）则重新压缩，上传阶段失败则直接重传
			async function retryOne(item) {
				item.error = "";
				item.status = item.out ? "compressed" : "pending";
				render();
				await compressQueue();
				await uploadQueue();
			}

			async function uploadQueue() {
				if (!auth) {
					alert("请先登录（复用 Sveltia CMS 登录态，或点击「使用 GitHub 授权登录」）");
					return;
				}
				// 上传失败的图（error 且已有压缩产物）也纳入重传，不再被静默跳过
				const pending = queue.filter(
					(item) => item.status === "compressed" || (item.status === "error" && item.out),
				);
				if (!pending.length) return;

				for (const item of pending) {
					item.status = "uploading";
					item.error = "";
				}
				render();

				// 先做内容去重：与仓库现有文件完全一致的直接复用，不产生新 commit
				const fresh = [];
				for (const item of pending) {
					const dup = await findDuplicate(item);
					if (dup) {
						item.uploadedName = dup.name;
						item.reused = true;
						item.status = "done";
					} else {
						fresh.push(item);
					}
				}
				render();

				if (!fresh.length) return; // 全部为重复内容

				try {
					if (fresh.length === 1) {
						await uploadSingle(fresh[0], 1);
						fresh[0].status = "done";
					} else {
						await uploadBatch(fresh);
						for (const item of fresh) item.status = "done";
					}
					// 增量更新目录缓存，同批次内及后续上传都能命中去重
					for (const item of fresh) {
						if (repoListing && item.uploadedName) {
							repoListing.push({ name: item.uploadedName, sha: item.blobSha, type: "file" });
						}
					}
				} catch (ex) {
					for (const item of fresh) {
						item.status = "error";
						item.uploadedName = "";
						item.error = `${fresh.length > 1 ? "批量上传失败" : "上传失败"}：${ex?.message || ex}`;
					}
				}
				render();
			}

			// ===== 渲染 =====
			function esc(s) {
				return String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
			}

			function render() {
				const list = document.getElementById("filelist");
				const toolbar = document.getElementById("toolbar");
				toolbar.style.display = queue.length ? "" : "none";
				list.innerHTML = "";
				for (const item of queue) {
					const out = item.out;
					const saving = out && out.size < item.raw.size ? `（省 ${Math.round((1 - out.size / item.raw.size) * 100)}%）` : "";
					const path = item.uploadedName ? `${PUBLIC_DIR}/${item.uploadedName}` : null;
					const row = document.createElement("div");
					row.className = "item";
					row.innerHTML = `
						<img src="${URL.createObjectURL(out || item.raw)}" alt="" />
						<div class="info">
							<div class="name" title="${esc(out ? out.name : item.raw.name)}">${esc(out ? out.name : item.raw.name)}</div>
							<div class="meta">
								${fmtSize(item.raw.size)}${out ? ` → <strong>${fmtSize(out.size)}</strong> <span class="save">${saving}</span>` : ""}
							</div>
							<div class="statusrow">
								${
									item.status === "error"
										? `<span class="badge err" title="${esc(item.error)}">${esc(item.error)}</span><button class="retry-btn" data-retry="${item.id}">重试</button>`
										: `<span class="badge ${STATUS_CLASS[item.status] || ""}">${item.reused ? "内容重复，已复用现有文件" : STATUS_TEXT[item.status]}</span>`
								}
							</div>
							${
								path
									? `<div class="links">
											<div class="linkrow"><code>${esc(`![](${SITE_URL}${path})`)}</code><button data-copy="${esc(`![](${SITE_URL}${path})`)}">复制 Markdown</button></div>
											<div class="linkrow"><code>${esc(`${SITE_URL}${path}`)}</code><button data-copy="${esc(`${SITE_URL}${path}`)}">复制链接</button></div>
											<div class="linkrow"><code>${esc(path)}</code><button data-copy="${esc(path)}">复制相对路径</button></div>
										</div>`
									: ""
							}
						</div>`;
					list.appendChild(row);
				}
				list.querySelectorAll("[data-retry]").forEach((btn) => {
					btn.addEventListener("click", () => {
						const item = queue.find((q) => q.id === Number(btn.getAttribute("data-retry")));
						if (item) retryOne(item);
					});
				});
				list.querySelectorAll("[data-copy]").forEach((btn) => {
					btn.addEventListener("click", async () => {
						const text = btn.getAttribute("data-copy");
						try {
							await navigator.clipboard.writeText(text);
						} catch {
							const ta = document.createElement("textarea");
							ta.value = text;
							document.body.appendChild(ta);
							ta.select();
							document.execCommand("copy");
							ta.remove();
						}
						const old = btn.textContent;
						btn.textContent = "已复制";
						setTimeout(() => (btn.textContent = old), 1200);
					});
				});
			}

			function addFiles(files) {
				for (const f of files) {
					if (!f.type.startsWith("image/")) continue;
					queue.push({ id: ++uid, raw: f, out: null, status: "pending", error: "", uploadedName: "" });
				}
				render();
				compressQueue();
			}

			// ===== 事件绑定 =====
			const dropzone = document.getElementById("dropzone");
			const fileinput = document.getElementById("fileinput");
			document.getElementById("pickbtn").addEventListener("click", (e) => {
				e.stopPropagation();
				fileinput.click();
			});
			dropzone.addEventListener("click", (e) => {
				if (e.target === dropzone) fileinput.click();
			});
			fileinput.addEventListener("change", () => {
				addFiles([...fileinput.files]);
				fileinput.value = "";
			});

			// 整页拖拽：拖到页面任意位置均可放置
			["dragenter", "dragover"].forEach((ev) =>
				document.addEventListener(ev, (e) => {
					e.preventDefault();
					dropzone.classList.add("drag");
				}),
			);
			document.addEventListener("dragleave", (e) => {
				// 仅在真正离开窗口时取消高亮，避免经过子元素时闪烁
				if (!e.relatedTarget) dropzone.classList.remove("drag");
			});
			document.addEventListener("drop", (e) => {
				e.preventDefault();
				dropzone.classList.remove("drag");
				addFiles([...e.dataTransfer.files]);
			});

			// 粘贴上传：Ctrl+V 直接粘贴剪贴板里的截图
			document.addEventListener("paste", (e) => {
				const files = [...(e.clipboardData?.items || [])]
					.filter((it) => it.kind === "file")
					.map((it) => it.getAsFile())
					.filter(Boolean);
				if (files.length) {
					e.preventDefault();
					addFiles(files);
				}
			});
			document.getElementById("uploadallbtn").addEventListener("click", uploadQueue);
			document.getElementById("recompressbtn").addEventListener("click", () => {
				for (const item of queue) {
					if (item.status === "uploading" || item.status === "done") continue;
					item.status = "pending";
					item.out = null;
				}
				render();
				compressQueue();
			});
			document.getElementById("clearbtn").addEventListener("click", () => {
				queue = [];
				render();
			});
			document.getElementById("loginbtn").addEventListener("click", loginWithGithub);

			// 启动：检查登录态
			validateAuth()
				.catch(() => false)
				.finally(renderAuthbar);
		</script>
	</body>
</html>
