---
import type { CollectionEntry } from "astro:content";
import type { HTMLTag, Polymorphic } from "astro/types";
import { Icon } from "astro-icon/components";
import FormattedDate from "@/components/FormattedDate.astro";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	post: CollectionEntry<"post">;
	withDesc?: boolean;
};

const { as: Tag = "div", post, withDesc = false } = Astro.props;
---

<FormattedDate class="text-muted min-w-30 font-semibold" date={post.data.publishDate} />
<Tag>
	{post.data.draft && <span class="text-red-500">（草稿） </span>}
	<a class="cactus-link" href={`/posts/${post.id}/`}>
		{post.data.title}
	</a>
	{post.data.password && (
		<Icon
			aria-hidden="true"
			class="ms-1 inline-block h-4 w-4 align-text-bottom"
			focusable="false"
			name="mdi:lock"
		/>
	)}
</Tag>
{withDesc && <q class="line-clamp-3 italic">{post.data.description}</q>}
